# Copy this file to .env.local (gitignored) to override which manifest the
# Shell's dev server fetches. Leave MFE_MANIFEST_URL unset/empty to use the
# real Ship Server manifest at /config/mfe-manifest.json (the default).
#
# Point it at a static local file to run full local federation against
# MFE dev servers running on their standard ports (see manifest.local.json.example):
#
#   MFE_MANIFEST_URL=http://localhost:5000/manifest.local.json
#
# ...or at another Ship Server / staging deployment's manifest endpoint to
# run the Shell locally against already-deployed MFEs (the hybrid mode):
#
#   MFE_MANIFEST_URL=https://staging.ship.internal/config/mfe-manifest.json
MFE_MANIFEST_URL=
